# Salin file ini menjadi .env lalu isi nilainya.
# .env TIDAK pernah di-commit (lihat .gitignore).

# ── PRODUKSI (Supabase + Vercel): cukup dua variabel di bawah ──────────
# ── LOKAL (sandbox SQLite + Prisma): jalankan `bun prisma/seed.ts` ────
# Prisma + SQLite (lokal). Di produksi TIDAK dipakai (data di Supabase).
# Contoh Windows : "file:C:/path tanpa spasi/db/custom.db"
# Contoh Linux   : file:./db/custom.db
DATABASE_URL=

# Secret sesi cookie (HMAC). Generate: openssl rand -base64 32
SESSION_SECRET=

# Seed dua akun pertama (tanpa registrasi publik). Jalankan: bun prisma/seed.ts
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_PARTNER_EMAIL=
SEED_PARTNER_PASSWORD=

# Supabase (produksi) — hanya nilai yang aman untuk client.
# JANGAN pernah menaruh service_role key di sini atau di frontend.
# (SATU-SATUNYA pengecualian: SUPABASE_SERVICE_ROLE_KEY di mesin lokal
#  untuk mode pratinjau di bawah — dilarang keras di Vercel.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mode pratinjau tanpa login — HANYA untuk pengembangan lokal.
# Biarkan kosong / hapus di produksi (default: login wajib).
# Butuh pasangan SUPABASE_SERVICE_ROLE_KEY (lokal saja!) untuk membaca
# identitas pratinjau. JANGAN PERNAH set keduanya di Vercel.
# AUTH_BYPASS=1
# SUPABASE_SERVICE_ROLE_KEY=